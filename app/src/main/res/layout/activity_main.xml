<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GameBoost"
            android:textColor="@color/accent_green"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Status card: CPU / Battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_dark"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCpuUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPU Usage: --%"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Battery: --%"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Free RAM: -- MB"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- FPS overlay control -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start FPS Overlay"
            android:layout_marginBottom="12dp" />

        <!-- Gaming mode -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGamingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Gaming Mode (DND)"
            android:layout_marginBottom="12dp" />

        <!-- Volume control -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Media Volume"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Note: RAM cleanup, GPU temperature and CPU overclocking are not shown here because modern Android does not allow apps to do these without root access on most devices."
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
